; OTTO vendor additions (vendor_b/etc/selinux/vendor_sepolicy.cil, appended). Proven live 2026-10-23.
; Composer starts before Magisk can add rules, so these must be in the image.
; It asks the QTI perf HAL for a boost on heavy composition (enable_perf_hint_large_comp_cycle=1).
(allow hal_graphics_composer_default vendor_hal_qspmhal_hwservice (hwservice_manager (find)))
(allow hal_graphics_composer_default graphics_config_prop (file (read open getattr map)))
(allow hal_graphics_composer_default graphics_config_writable_prop (file (read open getattr map)))
(allow hal_graphics_composer_default zygote_config_prop (file (read open getattr map)))
; USB HAL reads system props for the USB config (wired ADB / RCP switch by ly_link.sh).
(allow vendor_hal_usb_qti system_prop (file (read open getattr map)))
