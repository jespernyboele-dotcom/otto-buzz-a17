<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dk.otto.overlay.safezone">
    <!-- Mutable (not static): OTTO turns the safe zone on for Home and off for other apps at runtime,
         like the "simulate display cutout" developer overlays. -->
    <overlay android:targetPackage="android" android:category="com.android.internal.display_cutout_emulation" android:priority="1" />
    <application android:hasCode="false" />
</manifest>
